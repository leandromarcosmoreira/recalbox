From 54c32b05cd05b0f77781d8ac410558d8edb8275c Mon Sep 17 00:00:00 2001
From: digitalLumberjack <digitallumberjack@gmail.com>
Date: Tue, 8 Jul 2025 11:57:20 +0200
Subject: [PATCH 17/28] controls: add common remap

---
 configuration.c | 22 ++++++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/configuration.c b/configuration.c
index 2792482425..9174d9de21 100644
--- a/configuration.c
+++ b/configuration.c
@@ -4693,6 +4693,7 @@ bool config_load_remap(const char *directory_input_remapping,
 {
    /* final path for core-specific configuration (prefix+suffix) */
    char core_path[PATH_MAX_LENGTH];
+   char common_path[PATH_MAX_LENGTH];
    /* final path for game-specific configuration (prefix+suffix) */
    char game_path[PATH_MAX_LENGTH];
    /* final path for content-dir-specific configuration (prefix+suffix) */
@@ -4718,6 +4719,7 @@ bool config_load_remap(const char *directory_input_remapping,
 
    game_path[0]        = '\0';
    content_path[0]     = '\0';
+   common_path[0]      = '\0';
 
    if (   sort_remaps_by_controller
        && !string_is_empty(inp_dev_name)
@@ -4749,6 +4751,12 @@ bool config_load_remap(const char *directory_input_remapping,
             FILE_PATH_REMAP_EXTENSION,
             sizeof(game_path));
 
+      fill_pathname_join_special_ext(common_path,
+            directory_input_remapping, "common",
+            "common",
+            FILE_PATH_REMAP_EXTENSION,
+            sizeof(common_path));
+
       /* If a game remap file exists, load it. */
       if ((new_conf = config_file_new_from_path_to_string(game_path)))
       {
@@ -4811,6 +4819,20 @@ bool config_load_remap(const char *directory_input_remapping,
       }
    }
 
+
+   /* common file */
+   if ((new_conf = config_file_new_from_path_to_string(common_path)))
+   {
+      bool ret = input_remapping_load_file(new_conf, common_path);
+      config_file_free(new_conf);
+      new_conf = NULL;
+      RARCH_LOG("[Remaps]: common remap found at \"%s\".\n", common_path);
+      if (ret)
+      {
+         goto success;
+      }
+   }
+
    if (new_conf)
       config_file_free(new_conf);
    new_conf = NULL;
-- 
